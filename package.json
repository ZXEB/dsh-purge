{
  "name": "dsh-purge",
  "version": "1.1.76",
  "description": "DeepSeek Harness 本地运行时适配插件：一张可回滚的宿主默认值与提示词段补丁表，支持面板状态查看、一键应用/还原/卸载。 Local runtime adaptation plugin for DeepSeek Harness - a reversible patch table for host defaults and prompt segments.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "LICENSE",
    "install.ps1",
    "check.ps1",
    "INSTALL-OTHER-PC.md",
    "ADAPTATION-NOTES.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "harness",
    "compatibility",
    "patch",
    "policy",
    "prompt-segments",
    "settings",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZXEB/dsh-purge.git"
  },
  "homepage": "https://github.com/ZXEB/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/ZXEB/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/ZXEB/dsh-purge/archive/refs/heads/master.tar.gz",
      "zip": "https://github.com/ZXEB/dsh-purge/archive/refs/heads/master.zip",
      "git": "https://github.com/ZXEB/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.5"
}
